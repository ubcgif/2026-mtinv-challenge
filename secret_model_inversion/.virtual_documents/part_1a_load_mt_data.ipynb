elevation = n_files * [None]
frequencies = n_files * [None]
data_array = n_files * [None]

for ii, fname in enumerate(fnames):

    east, north, elev, freq, array = load_edi_file(fname)

    easting[ii] = east
    northing[ii] = north
    elevation[ii] = elev
    frequencies[ii] = freq
    data_array[ii] = array

